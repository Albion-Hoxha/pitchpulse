# Copy this file to .env and fill in the values from Microsoft Foundry.
# .env is git-ignored: never commit real keys.
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.services.ai.azure.com
# Leave the key empty to sign in with Entra ID instead (az login locally, managed identity on Azure).
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
