# Copy this file to .env and fill in the values from Microsoft Foundry.
# .env is git-ignored: never commit real keys.
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.services.ai.azure.com
# Leave the key empty to sign in with Entra ID instead (az login locally, managed identity on Azure).
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
# Optional: answer Ask-the-Match with the published Foundry agent (see pitchpulse/foundry_agent.py).
FOUNDRY_PROJECT_ENDPOINT=https://YOUR-RESOURCE.services.ai.azure.com/api/projects/YOUR-PROJECT
